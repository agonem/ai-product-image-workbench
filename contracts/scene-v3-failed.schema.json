{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.product-image-workbench.invalid/v3/scene-failed.json",
  "title": "SceneFailedV3",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 3
    },
    "event_type": {
      "const": "image.task.failed.v3"
    },
    "event_id": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
    },
    "task_id": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
    },
    "attempt_id": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
    },
    "correlation_id": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/error_code"
        },
        "safe_message": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/text"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "safe_message",
        "retryable"
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "event_type",
    "event_id",
    "task_id",
    "attempt_id",
    "correlation_id",
    "error",
    "duration_ms"
  ]
}
