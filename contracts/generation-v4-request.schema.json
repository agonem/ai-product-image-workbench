{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.product-image-workbench.invalid/v4/generation-request.json",
  "title": "GenerationRequestedV4",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 4
    },
    "event_type": {
      "const": "image.task.requested.v4"
    },
    "event_id": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
    },
    "task_id": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
    },
    "attempt_id": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
    },
    "correlation_id": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
    },
    "output_object_prefix": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/object_key"
    },
    "feature_type": {
      "enum": [
        "GIFT",
        "SCENE",
        "SELLING_POINT",
        "CUSTOM",
        "COMPOSE"
      ]
    },
    "product_asset": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/asset"
    },
    "gift_asset": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/asset"
    },
    "gift_position": {
      "enum": [
        "BOTTOM_RIGHT",
        "BOTTOM_LEFT",
        "RIGHT",
        "LEFT"
      ]
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "SOLID",
            "GRADIENT",
            "CUSTOM",
            "ORIGINAL"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "[^\\s]"
        }
      },
      "required": [
        "mode"
      ],
      "oneOf": [
        {
          "properties": {
            "mode": {
              "enum": [
                "SOLID",
                "GRADIENT"
              ]
            },
            "color": {}
          },
          "required": [
            "color"
          ],
          "not": {
            "required": [
              "prompt"
            ],
            "properties": {
              "prompt": {}
            }
          }
        },
        {
          "properties": {
            "mode": {
              "const": "CUSTOM"
            },
            "prompt": {}
          },
          "required": [
            "prompt"
          ],
          "not": {
            "required": [
              "color"
            ],
            "properties": {
              "color": {}
            }
          }
        },
        {
          "properties": {
            "mode": {
              "const": "ORIGINAL"
            }
          },
          "allOf": [
            {
              "not": {
                "required": [
                  "color"
                ],
                "properties": {
                  "color": {}
                }
              }
            },
            {
              "not": {
                "required": [
                  "prompt"
                ],
                "properties": {
                  "prompt": {}
                }
              }
            }
          ]
        }
      ]
    },
    "gift_card": {
      "type": "object",
      "additionalProperties": false,
      "description": "Gift shown in a white card drawn by the program (ADR-20261008-H).",
      "properties": {
        "size": {
          "enum": [
            "S",
            "M",
            "L"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "pattern": "[^\\s]"
        },
        "background": {
          "enum": [
            "ORIGINAL",
            "WHITE"
          ],
          "description": "Inside the card: the gift photo as it is, or the gift re-shot on white by the model (ADR-20261009-N)."
        }
      },
      "required": [
        "size"
      ]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "[^\\s]"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200,
          "pattern": "[^\\s]"
        }
      },
      "required": [
        "prompt"
      ]
    },
    "style_prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "[^\\s]"
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "[^\\s]",
      "description": "The user's own words (CUSTOM)."
    },
    "references": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/asset"
      }
    },
    "edit_image": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/asset",
      "description": "A previous result to modify; asset_id is the artifact id."
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "id",
        "name",
        "instructions"
      ]
    },
    "rewrite": {
      "const": true
    },
    "analyze": {
      "const": true,
      "description": "Chat: the bound text model looks at every input image and writes what it sees and the plan before the image call (ADR-20261009-P)."
    },
    "styles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "[^\\s]"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "[^\\s]"
          },
          "title_color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "badge_color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "badge_text_color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "accent_color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        },
        "required": [
          "id",
          "name",
          "prompt",
          "title_color",
          "badge_color",
          "badge_text_color",
          "accent_color"
        ]
      }
    },
    "per_point": {
      "const": true,
      "description": "Selling points: image i shows the title and point i (ADR-20261008-G)."
    },
    "keep_original": {
      "const": true,
      "description": "No model call: every base is the product image cropped to size."
    },
    "gift_reshoot": {
      "const": true,
      "description": "White gift card (ADR-20261009-N): one model call per attempt re-shoots the gift alone on white; its paid-call permit is ordinal output.count."
    },
    "product_position": {
      "enum": [
        "LEFT",
        "CENTER",
        "RIGHT"
      ],
      "description": "Where the model places the product (ADR-20261008-H); absent = away from the text."
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "[^\\s]"
        },
        "points": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "[^\\s]"
          }
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "size": {
          "type": "integer",
          "minimum": 12,
          "maximum": 240
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "box": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/box"
        }
      },
      "required": [
        "color",
        "size",
        "align",
        "box"
      ],
      "anyOf": [
        {
          "required": [
            "title"
          ],
          "properties": {
            "title": {}
          }
        },
        {
          "required": [
            "points"
          ],
          "properties": {
            "points": {}
          }
        }
      ]
    },
    "presets_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "[^\\s]"
    },
    "base_image": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/asset"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "task_id",
        "ordinal"
      ]
    },
    "template_snapshot": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/template_snapshot"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aspect_ratio": {
          "type": "string",
          "pattern": "^[1-9][0-9]?:[1-9][0-9]?$"
        },
        "width": {
          "type": "integer",
          "minimum": 64,
          "maximum": 2048
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "maximum": 2048
        },
        "format": {
          "enum": [
            "png",
            "jpeg"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "required": [
        "aspect_ratio",
        "width",
        "height",
        "format",
        "count"
      ]
    },
    "frame_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9:_-]{1,80}$"
    },
    "compose": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "image": {
                    "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/asset"
                  },
                  "x": {
                    "type": "number",
                    "minimum": -4,
                    "maximum": 4
                  },
                  "y": {
                    "type": "number",
                    "minimum": -4,
                    "maximum": 4
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 8
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 8
                  }
                },
                "required": [
                  "image",
                  "x",
                  "y",
                  "width",
                  "height"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "^[^\\n]*(\\n[^\\n]*){0,9}$"
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  },
                  "size": {
                    "type": "number",
                    "minimum": 0.004,
                    "maximum": 0.5
                  },
                  "align": {
                    "enum": [
                      "left",
                      "center",
                      "right"
                    ]
                  },
                  "x": {
                    "type": "number",
                    "minimum": -4,
                    "maximum": 4
                  },
                  "y": {
                    "type": "number",
                    "minimum": -4,
                    "maximum": 4
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 8
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 8
                  }
                },
                "required": [
                  "text",
                  "color",
                  "size",
                  "align",
                  "x",
                  "y",
                  "width",
                  "height"
                ]
              }
            ]
          }
        }
      },
      "required": [
        "background",
        "layers"
      ]
    },
    "resolution": {
      "enum": [
        "1K",
        "2K"
      ],
      "description": "Clarity: the model's output resolution (ADR-20261009-R); the output size is chosen separately."
    }
  },
  "required": [
    "schema_version",
    "event_type",
    "event_id",
    "task_id",
    "attempt_id",
    "correlation_id",
    "output_object_prefix",
    "feature_type",
    "presets_version",
    "template_snapshot",
    "output"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "feature_type": {
            "const": "COMPOSE"
          }
        },
        "required": [
          "feature_type"
        ]
      },
      "then": {
        "properties": {
          "compose": {}
        },
        "required": [
          "compose"
        ]
      },
      "else": {
        "properties": {
          "product_asset": {}
        },
        "required": [
          "product_asset"
        ]
      }
    }
  ]
}
