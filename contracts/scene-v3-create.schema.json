{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
    },
    "product_asset_id": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
    },
    "feature_type": {
      "const": "SCENE"
    },
    "layout": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/product_layout"
    },
    "scene_template_version_id": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
    },
    "scene_custom_prompt": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/text"
    },
    "style_custom_prompt": {
      "type": "string"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aspect_ratio": {
          "type": "string",
          "pattern": "^[1-9][0-9]?:[1-9][0-9]?$"
        },
        "format": {
          "enum": [
            "png",
            "jpeg"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "width": {
          "type": "integer",
          "minimum": 64,
          "maximum": 2048
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "maximum": 2048
        }
      },
      "required": [
        "aspect_ratio",
        "format",
        "count",
        "width",
        "height"
      ]
    }
  },
  "required": [
    "project_id",
    "product_asset_id",
    "feature_type",
    "layout",
    "output"
  ],
  "anyOf": [
    {
      "required": [
        "scene_template_version_id"
      ],
      "properties": {
        "scene_template_version_id": {}
      }
    },
    {
      "required": [
        "scene_custom_prompt"
      ],
      "properties": {
        "scene_custom_prompt": {}
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.product-image-workbench.invalid/v3/scene-create.json",
  "title": "SceneCreateV3"
}
