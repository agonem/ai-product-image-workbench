{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.product-image-workbench.invalid/v1/task-completed.json",
  "title": "ImageTaskCompletedV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "event_type": {
      "const": "image.task.completed.v1"
    },
    "event_id": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
    },
    "task_id": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
    },
    "attempt_id": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
    },
    "correlation_id": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/artifact"
      }
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "background_generation": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/background_generation"
    }
  },
  "required": [
    "schema_version",
    "event_type",
    "event_id",
    "task_id",
    "attempt_id",
    "correlation_id",
    "artifacts",
    "duration_ms",
    "background_generation"
  ]
}
