{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.product-image-workbench.invalid/v1/common.json",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "[^ \\t\\r\\n]"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "object_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9/_.-]*$",
      "not": {
        "pattern": "(^|/)\\.{1,2}(/|$)"
      }
    },
    "datetime": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "feature": {
      "enum": [
        "GIFT",
        "SCENE",
        "SELLING_POINT"
      ]
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "product_layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/box"
        }
      },
      "required": [
        "product"
      ]
    },
    "gift_layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/box"
        },
        "gift": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/box"
        }
      },
      "required": [
        "product",
        "gift"
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
        },
        "object_key": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/object_key"
        },
        "sha256": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/sha256"
        }
      },
      "required": [
        "asset_id",
        "object_key",
        "sha256"
      ]
    },
    "selling_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/text"
      }
    },
    "template_version": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
        },
        "template_id": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "published_by": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
        },
        "published_at": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/datetime"
        },
        "config": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "template_id",
        "version",
        "published_by",
        "published_at",
        "config"
      ]
    },
    "template_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "versions": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/template_version"
          }
        },
        "output_preset": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
            },
            "config": {
              "type": "object"
            }
          },
          "required": [
            "id",
            "config"
          ]
        }
      },
      "required": [
        "versions",
        "output_preset"
      ]
    },
    "error_code": {
      "enum": [
        "INVALID_ASSET",
        "UNAUTHORIZED_ASSET",
        "CUTOUT_REVIEW_REQUIRED",
        "INVALID_LAYOUT",
        "TEXT_OVERFLOW",
        "PROVIDER_UNAVAILABLE",
        "GENERATION_FAILED",
        "OUTPUT_VALIDATION_FAILED",
        "TASK_CONFLICT",
        "INVALID_CONTRACT"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/error_code"
        },
        "message": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/text"
        },
        "correlation_id": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
        }
      },
      "required": [
        "code",
        "message",
        "correlation_id"
      ]
    },
    "background_generation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/text"
            },
            "model": {
              "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/text"
            },
            "prompt": {
              "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/text"
            },
            "parameters": {
              "type": "object"
            },
            "request_id": {
              "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
            },
            "output_object_key": {
              "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/object_key"
            }
          },
          "required": [
            "provider",
            "model",
            "prompt",
            "parameters",
            "request_id",
            "output_object_key"
          ]
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "COMPOSITE",
            "BACKGROUND",
            "ALPHA"
          ]
        },
        "object_key": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/object_key"
        },
        "sha256": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/sha256"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "ordinal",
        "kind",
        "object_key",
        "sha256",
        "width",
        "height"
      ]
    },
    "public_artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
        },
        "kind": {
          "enum": [
            "COMPOSITE",
            "BACKGROUND",
            "ALPHA"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "kind",
        "width",
        "height"
      ]
    }
  }
}
