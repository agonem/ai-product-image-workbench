{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.product-image-workbench.invalid/v4/preset-catalog.json",
  "title": "Scene presets and selling-point styles saved by an admin (ADR-20260930-F)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "[^\\s]"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600,
            "pattern": "[^\\s]"
          }
        },
        "required": [
          "id",
          "name",
          "prompt"
        ]
      }
    },
    "styles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "[^\\s]"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "[^\\s]"
          },
          "title_color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "badge_color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "badge_text_color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "accent_color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        },
        "required": [
          "id",
          "name",
          "prompt",
          "title_color",
          "badge_color",
          "badge_text_color",
          "accent_color"
        ]
      }
    },
    "note": {
      "type": "string",
      "maxLength": 200
    }
  },
  "required": [
    "scenes",
    "styles"
  ]
}
