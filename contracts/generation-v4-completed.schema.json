{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.product-image-workbench.invalid/v4/generation-completed.json",
  "title": "GenerationCompletedV4",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 4
    },
    "event_type": {
      "const": "image.task.completed.v4"
    },
    "event_id": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
    },
    "task_id": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
    },
    "attempt_id": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
    },
    "correlation_id": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/artifact"
      }
    },
    "generations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "base": {
            "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/artifact"
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "schema_version": {
                "const": 1
              },
              "output_source": {
                "enum": [
                  "openrouter-images-api",
                  "openai-images-api",
                  "gemini-generate-content",
                  "retypeset",
                  "original",
                  "mock-acceptance-only"
                ]
              },
              "endpoint": {
                "type": "string",
                "pattern": "^https?://[^/?#@ ]{1,300}$"
              },
              "provider": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "provider_tag": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "template_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "parameters": {
                "type": "object"
              },
              "correlation_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 0
              },
              "usage": {
                "type": "object"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "inputs": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "product_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "gift_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "base_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "edit_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "reference_sha256": {
                    "type": "array",
                    "maxItems": 2,
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                },
                "required": [
                  "product_sha256"
                ]
              },
              "transform": {
                "type": "object"
              },
              "source_transform": {
                "type": "object"
              },
              "text_rendered": {
                "type": "boolean"
              },
              "review_status": {
                "const": "PENDING"
              }
            },
            "required": [
              "schema_version",
              "output_source",
              "sha256",
              "inputs",
              "transform",
              "text_rendered",
              "review_status"
            ]
          }
        },
        "required": [
          "ordinal",
          "base",
          "provenance"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "event_type",
    "event_id",
    "task_id",
    "attempt_id",
    "correlation_id",
    "duration_ms",
    "artifacts",
    "generations"
  ]
}
