{
  "version": "model-parameters-v2",
  "description": "Model interfaces and the official parameters an administrator may fill in for a model (ADR-20261012-AB; replaces the v1 lists of ADR-20261009-Q). A parameter left blank is not sent, so the vendor's default applies; a filled one is sent as typed. Sets match in order by interface kind, purpose and a regular expression on the model id; the first match wins. Names with dots are nested objects in the request body. Parameters the system sets per task (model, prompt, messages, images, aspect ratio or size, count, clarity, output format) are never listed. 'resolutions' maps each clarity the generation pages may offer to the parameters that request it. Compiled from the vendors' documentation and OpenRouter's published per-model parameters on 2026-10-12.",
  "kinds": {
    "openrouter": {
      "label": "OpenRouter",
      "purposes": [
        "IMAGE",
        "TEXT"
      ],
      "offered": true,
      "examples": {
        "IMAGE": [
          "openai/gpt-image-2",
          "openai/gpt-image-2.5-flare",
          "bytedance-seed/seedream-5-0-pro",
          "bytedance-seed/seedream-5-0-lite",
          "google/gemini-3.1-flash-image"
        ],
        "TEXT": [
          "deepseek/deepseek-v4.1-flash"
        ]
      }
    },
    "openai": {
      "label": "OpenAI 官方",
      "purposes": [
        "IMAGE",
        "TEXT"
      ],
      "offered": true,
      "examples": {
        "IMAGE": [
          "gpt-image-2"
        ],
        "TEXT": []
      }
    },
    "deepseek": {
      "label": "DeepSeek 官方",
      "purposes": [
        "TEXT"
      ],
      "offered": true,
      "examples": {
        "TEXT": [
          "deepseek-flash",
          "deepseek-v4-pro"
        ]
      }
    },
    "gemini": {
      "label": "Gemini 官方",
      "purposes": [
        "IMAGE",
        "TEXT"
      ],
      "offered": true,
      "examples": {
        "IMAGE": [
          "gemini-2.5-flash-image"
        ],
        "TEXT": []
      }
    },
    "openai-compatible": {
      "label": "兼容 OpenAI 协议的第三方",
