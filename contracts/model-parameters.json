{
  "version": "model-parameters-v1",
  "description": "Per-model parameters an administrator may set, and which clarity (1K or 2K output) the generation pages may offer (ADR-20261009-Q, -R). Families are matched in order by purpose and a regular expression on the model id; the first match wins. Values follow OpenRouter's published Images API capabilities as of 2026-10-09 and are limited to what this system can handle (up to 2K; 4K is left out). 'resolutions' maps each clarity to the parameters that request it. The Worker still has OpenRouter check every value before a paid call.",
  "families": [
    {
      "id": "gpt-image-2.5",
      "name": "OpenAI GPT Image 2.5",
      "purpose": "IMAGE",
      "match": "^(openai/)?gpt-image-2\\.5",
      "parameters": {
        "quality": {
          "label": "画质档",
          "default": "auto",
          "values": [
            {
              "value": "auto",
              "label": "自动"
            },
            {
              "value": "low",
              "label": "低"
            },
            {
              "value": "medium",
              "label": "中"
            },
            {
              "value": "high",
              "label": "高"
            },
            {
              "value": "xhigh",
              "label": "很高"
            },
            {
              "value": "max",
              "label": "最高"
            }
          ]
        }
      },
      "resolutions": {
        "1K": {}
      }
    },
    {
      "id": "gpt-image",
      "name": "OpenAI GPT Image",
      "purpose": "IMAGE",
      "match": "^(openai/)?gpt-image",
      "parameters": {
        "quality": {
          "label": "画质档",
          "default": "auto",
          "values": [
            {
              "value": "auto",
              "label": "自动"
            },
            {
              "value": "low",
              "label": "低"
            },
            {
              "value": "medium",
              "label": "中"
            },
            {
              "value": "high",
              "label": "高"
            }
          ]
        }
      },
      "resolutions": {
        "1K": {}
      }
    },
    {
      "id": "seedream-lite",
      "name": "Seedream 5.0 Lite",
      "purpose": "IMAGE",
      "match": "^(bytedance-seed/)?seedream-5-0-lite",
      "parameters": {
        "resolution": {
          "label": "分辨率",
          "default": "2K",
          "values": [
            {
              "value": "2K",
              "label": "2K"
            }
          ]
        }
      },
      "resolutions": {
        "2K": {
          "resolution": "2K"
        }
      }
    },
    {
      "id": "seedream",
      "name": "Seedream",
      "purpose": "IMAGE",
      "match": "^(bytedance-seed/)?seedream",
      "parameters": {
        "resolution": {
          "label": "分辨率",
          "default": "1K",
          "values": [
            {
              "value": "1K",
              "label": "1K"
            },
            {
              "value": "2K",
              "label": "2K"
            }
          ]
        }
      },
      "resolutions": {
        "1K": {
          "resolution": "1K"
        },
        "2K": {
          "resolution": "2K"
        }
      }
    },
    {
      "id": "gemini-lite-image",
      "name": "Nano Banana 2 Lite",
      "purpose": "IMAGE",
      "match": "^(google/)?gemini-3\\.1-flash-lite-image",
      "parameters": {},
      "resolutions": {
        "1K": {}
      }
    },
    {
      "id": "gemini-image",
      "name": "Nano Banana 2 / Pro / 2.1",
      "purpose": "IMAGE",
      "match": "^(google/)?gemini-(3(\\.1)?-(pro|flash)-image|nano-banana)",
      "parameters": {
        "resolution": {
          "label": "分辨率",
          "default": "1K",
          "values": [
            {
              "value": "1K",
              "label": "1K"
            },
            {
              "value": "2K",
              "label": "2K"
            }
          ]
        }
      },
      "resolutions": {
        "1K": {
          "resolution": "1K"
        },
        "2K": {
          "resolution": "2K"
        }
      }
    },
    {
      "id": "text",
      "name": "Text models",
      "purpose": "TEXT",
      "match": ".",
      "parameters": {
        "temperature": {
          "label": "创意程度（温度）",
          "default": "0.7",
          "values": [
            {
              "value": "0.2",
              "label": "严谨（0.2）"
            },
            {
