{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.product-image-workbench.invalid/v4/generation-create.json",
  "title": "GenerationCreateV4",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
        },
        "product_asset_id": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
        },
        "style_prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "[^\\s]"
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "aspect_ratio": {
              "type": "string",
              "pattern": "^[1-9][0-9]?:[1-9][0-9]?$"
            },
            "width": {
              "type": "integer",
              "minimum": 64,
              "maximum": 2048
            },
            "height": {
              "type": "integer",
              "minimum": 64,
              "maximum": 2048
            },
            "format": {
              "enum": [
                "png",
                "jpeg"
              ]
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          },
          "required": [
            "aspect_ratio",
            "width",
            "height",
            "format",
            "count"
          ]
        },
        "feature_type": {
          "const": "GIFT"
        },
        "gift_asset_id": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
        },
        "gift_position": {
          "enum": [
            "BOTTOM_RIGHT",
            "BOTTOM_LEFT",
            "RIGHT",
            "LEFT"
          ]
        },
        "background": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "SOLID",
                "GRADIENT",
                "CUSTOM",
                "ORIGINAL"
              ]
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "[^\\s]"
            }
          },
          "required": [
            "mode"
          ],
          "oneOf": [
            {
              "properties": {
                "mode": {
                  "enum": [
                    "SOLID",
                    "GRADIENT"
                  ]
                },
                "color": {}
              },
              "required": [
                "color"
              ],
              "not": {
                "required": [
                  "prompt"
                ],
                "properties": {
                  "prompt": {}
                }
              }
            },
            {
              "properties": {
                "mode": {
                  "const": "CUSTOM"
                },
                "prompt": {}
              },
              "required": [
                "prompt"
              ],
              "not": {
                "required": [
                  "color"
                ],
                "properties": {
                  "color": {}
                }
              }
            },
            {
              "properties": {
                "mode": {
                  "const": "ORIGINAL"
                }
              },
              "allOf": [
                {
                  "not": {
                    "required": [
                      "color"
                    ],
                    "properties": {
                      "color": {}
                    }
                  }
                },
                {
                  "not": {
                    "required": [
                      "prompt"
                    ],
                    "properties": {
                      "prompt": {}
                    }
                  }
                }
              ]
            }
          ]
        },
        "gift_card": {
          "type": "object",
          "additionalProperties": false,
          "description": "Gift shown in a white card drawn by the program (ADR-20261008-H).",
          "properties": {
            "size": {
              "enum": [
                "S",
                "M",
                "L"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10,
              "pattern": "[^\\s]"
            }
          },
          "required": [
            "size"
          ]
        },
        "text": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "pattern": "[^\\s]"
            },
            "points": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20,
                "pattern": "[^\\s]"
              }
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "size": {
              "type": "integer",
              "minimum": 12,
              "maximum": 240
            },
            "align": {
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "box": {
              "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/box"
            }
          },
          "required": [
            "color",
            "size",
            "align",
            "box"
          ],
          "anyOf": [
            {
              "required": [
                "title"
              ],
              "properties": {
                "title": {}
              }
            },
            {
              "required": [
                "points"
              ],
              "properties": {
                "points": {}
              }
            }
          ]
        },
        "model_id": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id",
          "description": "Chosen model (ADR-20260929-C); omitted means the admin default."
        }
      },
      "required": [
        "project_id",
        "product_asset_id",
        "feature_type",
        "gift_asset_id",
        "gift_position",
        "output"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
        },
        "product_asset_id": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
        },
        "style_prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "[^\\s]"
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "aspect_ratio": {
              "type": "string",
              "pattern": "^[1-9][0-9]?:[1-9][0-9]?$"
            },
            "width": {
              "type": "integer",
              "minimum": 64,
              "maximum": 2048
            },
            "height": {
              "type": "integer",
              "minimum": 64,
              "maximum": 2048
            },
            "format": {
              "enum": [
                "png",
                "jpeg"
              ]
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          },
          "required": [
            "aspect_ratio",
            "width",
            "height",
            "format",
            "count"
          ]
        },
        "feature_type": {
          "const": "SCENE"
        },
        "scene_preset": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        "scene_prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "[^\\s]"
        },
        "model_id": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id",
          "description": "Chosen model (ADR-20260929-C); omitted means the admin default."
        }
      },
      "required": [
        "project_id",
        "product_asset_id",
        "feature_type",
        "output"
      ],
      "anyOf": [
        {
          "required": [
            "scene_preset"
          ],
          "properties": {
            "scene_preset": {}
          }
        },
        {
          "required": [
            "scene_prompt"
          ],
          "properties": {
            "scene_prompt": {}
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
        },
        "product_asset_id": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
        },
        "style_prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "[^\\s]"
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "aspect_ratio": {
              "type": "string",
              "pattern": "^[1-9][0-9]?:[1-9][0-9]?$"
            },
            "width": {
              "type": "integer",
              "minimum": 64,
              "maximum": 2048
            },
            "height": {
              "type": "integer",
              "minimum": 64,
              "maximum": 2048
            },
            "format": {
              "enum": [
                "png",
                "jpeg"
              ]
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          },
          "required": [
            "aspect_ratio",
            "width",
            "height",
            "format",
            "count"
          ]
        },
        "feature_type": {
          "const": "SELLING_POINT"
        },
        "style": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "description": "One selling-point style; one image per point (ADR-20261008-G)."
        },
        "keep_original": {
          "const": true,
          "description": "No model call: the product image itself is cropped and the text overlaid (ADR-20261008-G)."
        },
        "product_position": {
          "enum": [
            "LEFT",
            "CENTER",
            "RIGHT"
          ],
          "description": "Where the model places the product (ADR-20261008-H); absent = away from the text."
        },
        "text": {
          "allOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60,
                  "pattern": "[^\\s]"
                },
                "points": {
                  "type": "array",
                  "maxItems": 6,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20,
                    "pattern": "[^\\s]"
                  }
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "size": {
                  "type": "integer",
                  "minimum": 12,
                  "maximum": 240
                },
                "align": {
                  "enum": [
                    "left",
                    "center",
                    "right"
                  ]
                },
                "box": {
                  "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/box"
                }
              },
              "required": [
                "color",
                "size",
                "align",
                "box"
              ],
              "anyOf": [
                {
                  "required": [
                    "title"
                  ],
                  "properties": {
                    "title": {}
                  }
                },
                {
                  "required": [
                    "points"
                  ],
                  "properties": {
                    "points": {}
                  }
                }
              ]
            },
            {
              "type": "object",
              "required": [
                "points"
              ],
              "properties": {
                "points": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          ]
        },
        "model_id": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id",
          "description": "Chosen model (ADR-20260929-C); omitted means the admin default."
        }
      },
      "required": [
        "project_id",
        "product_asset_id",
        "feature_type",
        "text",
        "output"
      ],
      "oneOf": [
        {
          "required": [
            "style"
          ],
          "properties": {
            "style": {}
          },
          "not": {
            "required": [
              "keep_original"
            ],
            "properties": {
              "keep_original": {}
            }
          }
        },
        {
          "required": [
            "keep_original"
          ],
          "properties": {
            "keep_original": {}
          },
          "allOf": [
            {
              "not": {
                "required": [
                  "style"
                ],
                "properties": {
                  "style": {}
                }
              }
            },
            {
              "not": {
                "required": [
                  "model_id"
                ],
                "properties": {
                  "model_id": {}
                }
              }
            },
            {
              "not": {
                "required": [
                  "style_prompt"
                ],
                "properties": {
                  "style_prompt": {}
                }
              }
            },
            {
              "not": {
                "required": [
                  "product_position"
                ],
                "properties": {
                  "product_position": {}
                }
              }
            }
          ]
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "description": "Conversational generation with the user's own prompt (ADR-20261008-I).",
      "properties": {
        "project_id": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
        },
        "product_asset_id": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "aspect_ratio": {
              "type": "string",
              "pattern": "^[1-9][0-9]?:[1-9][0-9]?$"
            },
            "width": {
              "type": "integer",
              "minimum": 64,
              "maximum": 2048
            },
            "height": {
              "type": "integer",
              "minimum": 64,
              "maximum": 2048
            },
            "format": {
              "enum": [
                "png",
                "jpeg"
              ]
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          },
          "required": [
            "aspect_ratio",
            "width",
            "height",
            "format",
            "count"
          ]
        },
        "feature_type": {
          "const": "CUSTOM"
        },
        "conversation_id": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "[^\\s]"
        },
        "reference_asset_ids": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
          }
        },
        "edit_artifact_id": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
        },
        "model_id": {
          "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id",
          "description": "Chosen model (ADR-20260929-C); omitted means the admin default."
        }
      },
      "required": [
        "project_id",
        "product_asset_id",
        "feature_type",
        "conversation_id",
        "prompt",
        "output"
      ]
    }
  ]
}
