{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 3
    },
    "event_type": {
      "const": "image.task.requested.v3"
    },
    "event_id": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
    },
    "task_id": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
    },
    "attempt_id": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
    },
    "correlation_id": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/id"
    },
    "product_asset": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/asset"
    },
    "product_alpha_asset": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/asset"
    },
    "output_object_prefix": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/object_key"
    },
    "template_snapshot": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/template_snapshot"
    },
    "feature_type": {
      "const": "SCENE"
    },
    "layout": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/product_layout"
    },
    "scene_template_prompt": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/text"
    },
    "scene_custom_prompt": {
      "$ref": "https://schemas.product-image-workbench.invalid/v1/common.json#/$defs/text"
    },
    "style_custom_prompt": {
      "type": "string"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aspect_ratio": {
          "type": "string",
          "pattern": "^[1-9][0-9]?:[1-9][0-9]?$"
        },
        "format": {
          "enum": [
            "png",
            "jpeg"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "width": {
          "type": "integer",
          "minimum": 64,
          "maximum": 2048
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "maximum": 2048
        }
      },
      "required": [
        "aspect_ratio",
        "format",
        "count",
        "width",
        "height"
      ]
    }
  },
  "required": [
    "schema_version",
    "event_type",
    "event_id",
    "task_id",
    "attempt_id",
    "correlation_id",
    "product_asset",
    "product_alpha_asset",
    "output_object_prefix",
    "template_snapshot",
    "feature_type",
    "layout",
    "output"
  ],
  "anyOf": [
    {
      "required": [
        "scene_template_prompt"
      ],
      "properties": {
        "scene_template_prompt": {}
      }
    },
    {
      "required": [
        "scene_custom_prompt"
      ],
      "properties": {
        "scene_custom_prompt": {}
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.product-image-workbench.invalid/v3/scene-request.json",
  "title": "SceneRequestV3"
}
