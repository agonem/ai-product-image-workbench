# Optional process environment; Java/Python do not auto-load this file.
BUSINESS_HOST=127.0.0.1
BUSINESS_PORT=8080
IMAGE_HOST=127.0.0.1
IMAGE_PORT=8001

# T03 optional database profile. Never put credentials in DB_URL.
# SPRING_PROFILES_ACTIVE=database
# DB_URL=jdbc:postgresql://127.0.0.1:5432/workbench
# DB_USER=workbench_dev
# DB_PASSWORD=
# PG_BIN=D:/tools/postgresql/pgsql/bin

# T05 opt-in local runtime; includes database. Generate credentials outside Git.
# SPRING_PROFILES_ACTIVE=runtime
# RUNTIME_USER_ID=
# RUNTIME_API_TOKEN=
# RUNTIME_WORKER_TOKEN=
# OBJECT_STORE_ROOT=D:/private/workbench/objects
# WORKER_API_URL=http://127.0.0.1:8080
# WORKER_JOURNAL_ROOT=D:/private/workbench/worker-journal
# WORK_LEASE_SECONDS=60
# WORK_MAX_DELIVERIES=3
# WORK_BACKOFF_SECONDS=2
# WORK_MAX_ATTEMPTS=5
# OBJECT_MAX_BYTES=10485760
# OBJECT_MAX_PIXELS=16000000

# T04 alternative: development accounts only, never production authentication.
# dev-local includes runtime/database; API token and fixed user ID are NOT used.
# SPRING_PROFILES_ACTIVE=dev-local
# APP_ENV=development
# DEV_ACCOUNTS_FILE=D:/private/workbench/dev-accounts.json
# DEV_SESSION_SECONDS=900
# DB_* / RUNTIME_WORKER_TOKEN / OBJECT_STORE_ROOT are still required.
# Generate the private account file with scripts/dev_accounts.py; do not commit it.

# T09 server-only background adapter; no VITE_* aliases; not auto-loaded.
# Set exactly one key source in the Python server process. Never commit real values.
# OPENROUTER_API_KEY=
# OPENROUTER_API_KEY_FILE=D:/private/workbench/openrouter.key
# Explicit image model and provider_tag from official endpoint discovery; no guessed default.
# OPENROUTER_MODEL=
# OPENROUTER_PROVIDER_TAG=
# Fixed HTTPS Images API; capability discovery must allow ratio/resolution/output_format.
# Adapter is standalone: existing Worker generation remains unavailable.
