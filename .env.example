# Optional process environment; Java/Python do not auto-load this file.
BUSINESS_HOST=127.0.0.1
BUSINESS_PORT=8080
IMAGE_HOST=127.0.0.1
IMAGE_PORT=8001

# T03 optional database profile. Uncomment only for your own development database.
# Do not put credentials in DB_URL. Obtain DB_PASSWORD outside this repository.
# SPRING_PROFILES_ACTIVE=database
# DB_URL=jdbc:postgresql://127.0.0.1:5432/workbench
# DB_USER=workbench_dev
# DB_PASSWORD=

# Disposable migration verification: native PostgreSQL 17 bin directory.
# PG_BIN=D:/tools/postgresql/pgsql/bin
