# Optional process environment; Java/Python do not auto-load this file.
BUSINESS_HOST=127.0.0.1
BUSINESS_PORT=8080
IMAGE_HOST=127.0.0.1
IMAGE_PORT=8001

# T03 optional database profile. Never put credentials in DB_URL.
# SPRING_PROFILES_ACTIVE=database
# DB_URL=jdbc:postgresql://127.0.0.1:5432/workbench
# DB_USER=workbench_dev
# DB_PASSWORD=
# PG_BIN=D:/tools/postgresql/pgsql/bin

# T05 opt-in local runtime; includes database. Generate credentials outside Git.
# SPRING_PROFILES_ACTIVE=runtime
# RUNTIME_USER_ID=
# RUNTIME_API_TOKEN=
# RUNTIME_WORKER_TOKEN=
# OBJECT_STORE_ROOT=D:/private/workbench/objects
# WORKER_API_URL=http://127.0.0.1:8080
# WORKER_JOURNAL_ROOT=D:/private/workbench/worker-journal
# WORK_LEASE_SECONDS=60
# WORK_MAX_DELIVERIES=3
# WORK_BACKOFF_SECONDS=2
# WORK_MAX_ATTEMPTS=5
# OBJECT_MAX_BYTES=52428800
# OBJECT_MAX_PIXELS=100000000

# T04 alternative: development accounts only, never production authentication.
# dev-local includes runtime/database; API token and fixed user ID are NOT used.
# SPRING_PROFILES_ACTIVE=dev-local
# APP_ENV=development
# DEV_ACCOUNTS_FILE=D:/private/workbench/dev-accounts.json
# DEV_SESSION_SECONDS=900
# DB_* / RUNTIME_WORKER_TOKEN / OBJECT_STORE_ROOT are still required.
# Generate the private account file with scripts/dev_accounts.py; do not commit it.

# T09 server-only background adapter; no VITE_* aliases; not auto-loaded.
# Set exactly one key source in the Python server process. Never commit real values.
# OPENROUTER_API_KEY=
# OPENROUTER_API_KEY_FILE=D:/private/workbench/openrouter.key
# Explicit image model and provider_tag from official endpoint discovery; no guessed default.
# OPENROUTER_MODEL=
# OPENROUTER_PROVIDER_TAG=
# Fixed HTTPS Images API; capability discovery must allow ratio/resolution/output_format.
# Python only: explicitly opt into a private env file; only OPENROUTER_* keys above are read.
# OPENROUTER_ENV_FILE=D:/private/workbench/.env
# This file is never loaded by Java or the browser. Existing process settings take precedence.
# Production Worker keeps TLS chain/hostname verification enabled.
# APP_ENV=production
# WORKER_API_URL=https://business.internal.example
# WORKER_CA_FILE=D:/private/workbench/trusted-ca.pem
# Java deployment capabilities (technical limits, not marketplace/business rules).
# Enable only after the configured provider's exact parameters have been verified.
# v4 whole-image generation (ADR-20260929). Worker needs a Chinese-capable font for text.
# GENERATION_ENABLED=true
# GENERATION_ASPECT_RATIOS=1:1,3:4,4:3,2:3,3:2,9:16,16:9
# GENERATION_MAX_COUNT=4
# GENERATION_TEXT_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# Face inside a .ttc collection; 2 = Simplified Chinese in Noto Sans CJK (0 is Japanese).
# GENERATION_TEXT_FONT_INDEX=2
# Optional explicit proxy for model calls only; ambient HTTPS_PROXY is ignored.
# OPENROUTER_PROXY_URL=http://proxy.internal:3128
# The model receives only aspect_ratio; exact output sizes are exported locally.
# Scene v2/v3 and cutout (SCENE_*, IMAGE_SERVICE_*) were removed by ADR-20260929.

# T09-C admin provider configuration (prod-local ADMIN only; V6 tables). Never commit values.
# Master key must be exactly 32 bytes base64; keep it outside the database and logs.
# PROVIDER_MASTER_KEY=
# PROVIDER_MASTER_KEY_FILE=D:/private/workbench/provider-master.key
