# Vite development server only. Never put secrets in frontend environment files.
DEV_HOST=127.0.0.1
DEV_PORT=5173
DEV_API_TARGET=http://127.0.0.1:8080
# Optional build-time override: development-only or production-local.
# Unset: Vite dev uses development-only; production builds use production-local.
# VITE_AUTH_MODE=production-local
# Production serves /api on the same HTTPS origin through a certificate-validating proxy.
